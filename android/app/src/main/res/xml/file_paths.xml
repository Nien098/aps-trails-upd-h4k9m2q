<?xml version="1.0" encoding="utf-8"?>
<!-- Exposes app-private storage to the FileProvider declared in
     AndroidManifest.xml, for the downloaded update APK.

     Confirmed via a real device error (2026-07): path_provider's
     getApplicationDocumentsDirectory() on Android saves to an "app_flutter/"
     folder that is a SIBLING of files/, cache/, and the external-files dir —
     not contained in any of them, so no combination of files-path/cache-path
     /external-files-path can ever cover it. root-path (device filesystem
     root) is the only tag general enough to reach it. Safe to be this broad
     since the provider is exported="false" and only ever reached via URIs we
     grant ourselves, never browsable by other apps. -->
<paths>
    <root-path name="app_root" path="."/>
</paths>
