{
  "version": 8,
  "name": "TrailGuide Coquitlam",
  "glyphs": "file://__DOC__/glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "protomaps": {
      "type": "vector",
      "url": "pmtiles://file://__DOC__/map/__REGION__.pmtiles",
      "attribution": "© OpenStreetMap"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#f7f5ee" }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landcover",
      "filter": ["match", ["get", "kind"], ["wood", "forest", "tree", "scrub", "grass"], true, false],
      "paint": { "fill-color": "#cfe8bf", "fill-opacity": 0.7 }
    },
    {
      "id": "landuse-park",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "landuse",
      "filter": ["match", ["get", "kind"], ["park", "recreation_ground", "pitch", "garden", "golf_course", "cemetery", "forest", "nature_reserve"], true, false],
      "paint": { "fill-color": "#bfe3a8", "fill-opacity": 0.85 }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "water",
      "filter": ["any", ["!=", ["get", "kind"], "water"], ["has", "kind_detail"]],
      "paint": {
        "fill-color": "#accdea",
        "fill-opacity": 0.75
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "protomaps",
      "source-layer": "buildings",
      "paint": { "fill-color": "#e2ddd0", "fill-outline-color": "#cfc9b8" }
    },
    {
      "id": "roads-casing",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": ["match", ["get", "kind"], ["highway", "major_road", "medium_road", "minor_road"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#c9b98f",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 3, 15, 12, 18, 26]
      }
    },
    {
      "id": "roads-fill",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": ["match", ["get", "kind"], ["highway", "major_road", "medium_road", "minor_road"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#ffffff",
        "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1.5, 15, 8, 18, 20]
      }
    },
    {
      "id": "sidewalks",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": ["all", ["==", ["get", "kind"], "path"], ["match", ["get", "kind_detail"], ["sidewalk", "crossing"], true, false]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#d9cfb8",
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 1, 18, 3]
      }
    },
    {
      "id": "trails",
      "type": "line",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": ["all", ["==", ["get", "kind"], "path"], ["match", ["get", "kind_detail"], ["sidewalk", "crossing"], false, true]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#3F51B5",
        "line-width": ["interpolate", ["linear"], ["zoom"], 12, 2.5, 15, 6, 18, 12]
      }
    },
    {
      "id": "trail-labels",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": ["all", ["match", ["get", "kind"], ["path"], true, false], ["has", "name"]],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Medium"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 16, 18, 22],
        "text-letter-spacing": 0.02
      },
      "paint": {
        "text-color": "#7a2c10",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2.5
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "roads",
      "filter": ["all", ["match", ["get", "kind"], ["highway", "major_road", "medium_road", "minor_road"], true, false], ["has", "name"]],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Medium"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 12, 15, 18, 21]
      },
      "paint": {
        "text-color": "#2b2b2b",
        "text-halo-color": "#ffffff",
        "text-halo-width": 2.5
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "protomaps",
      "source-layer": "places",
      "filter": ["has", "name"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Medium"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 20, 15, 30],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#1a1a1a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 3
      }
    }
  ]
}
